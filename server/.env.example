# Server Port
PORT=5000

# Node Environment: 'production' or 'development'
NODE_ENV=production

# MongoDB Connection String (Atlas URI or local/Docker MongoDB)
# Example: mongodb+srv://username:password@cluster.mongodb.net/emergency_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/emergency_db

# MongoDB Pool Tuning
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=5

# JSON Web Token Secret (Must be >= 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
JWT_EXPIRES_IN=7d

# Allowed CORS Origins (comma-separated, no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,https://admin.yourdomain.com

# Reverse Proxy Trust (1 for single reverse proxy like Nginx/Cloudflare, or hops count)
TRUST_PROXY=1

# Global API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Password Hashing Salt Rounds (12 is standard, 10-12 recommended for production)
BCRYPT_SALT_ROUNDS=12

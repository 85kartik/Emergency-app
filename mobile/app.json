{
  "expo": {
    "name": "Emergency Response",
    "slug": "emergency-response",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "emergency",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#dc2626"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Location is used only when you submit an SOS emergency to help responders find you."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#dc2626"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Emergency Response to use your location only when submitting an SOS alert."
        }
      ]
    ]
  }
}

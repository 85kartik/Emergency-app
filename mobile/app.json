{
  "expo": {
    "name": "Emergency Response",
    "slug": "emergency-response",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "emergency",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0f0c29"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergencyresponse.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used only during an SOS emergency to immediately dispatch responders to your coordinates.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Your location is used to dispatch responders to your coordinates during an SOS emergency."
      }
    },
    "android": {
      "package": "com.emergencyresponse.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#dc2626"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Emergency Response to use your location when submitting an SOS emergency alert."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0d86208b-bbd2-416f-a3de-6dd06e690853"
      },
      "apiUrl": "https://emergency-response-api.onrender.com",
      "router": {}
    },
    "owner": "kartikparab"
  }
}
